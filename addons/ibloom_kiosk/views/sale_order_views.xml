<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_ibloom_kitchen"
            model="ir.ui.view">

        <field name="name">sale.order.form.ibloom.kitchen</field>
        <field name="model">sale.order</field>

        <field name="inherit_id"
               ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']"
                   position="after">

                <field name="ibloom_order_mode"/>

                <field name="ibloom_kitchen_state"/>

            </xpath>

        </field>

    </record>

</odoo>
